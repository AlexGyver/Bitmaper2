{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bitmaper2",
  "version": "2.0.7",
  "identifier": "com.bitmaper.dev",
  "build": {
    "frontendDist": "../dist/tauri",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build_tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Bitmaper2",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
